# Copy this file to .env and fill in your values. .env is git-ignored.

# Required: your Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-api-key

# Optional: Gemini endpoint. Must end with "?key=" because the key is appended to it.
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=

# Optional: only needed if the web UI is hosted on a different origin than the backend
# VITE_API_URL=http://localhost:8080
